# Target environment: local | qa | staging | prod-like
TARGET_ENV=local

# Open-Meteo uses public API; optional overrides
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Stripe test mode (https://docs.stripe.com/api/authentication)
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2024-11-20.acacia

# Optional webhook secret for signature fixture tests (use a test value or real whsec_ for SDK-aligned tests)
STRIPE_WEBHOOK_SECRET=

# Plaid sandbox (https://plaid.com/docs/sandbox/)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_INSTITUTION_ID=ins_109508
PLAID_INITIAL_PRODUCTS=investments

# Alpaca paper (https://docs.alpaca.markets/us/docs/paper-trading)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Coinbase Exchange (https://docs.cdp.coinbase.com/exchange/rest-api/authentication)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# FRED (https://fred.stlouisfed.org/docs/api/fred/v2/api_key.html)
FRED_API_KEY=

# SEC — public files; set a descriptive User-Agent per https://www.sec.gov/developer
SEC_USER_AGENT=apiautomation/1.0 (+https://example.com/contact)

# Optional base URL overrides (advanced)
# STRIPE_BASE_URL=
# SEC_BASE_URL=

# Notifications (optional — set NOTIFY_ENABLED=true and SMTP_* in GitHub Actions secrets for CI)
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
NOTIFY_ONLY_ON_FAILURE=false
