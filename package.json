{
  "name": "apiautomation",
  "version": "1.0.0",
  "private": true,
  "description": "Modular API automation framework (Playwright Test + TypeScript)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ci": "playwright test",
    "test:open-meteo": "playwright test --project=open-meteo",
    "test:stripe": "playwright test --project=stripe",
    "import:postman": "tsx scripts/import-postman-demo.ts",
    "verify:open-meteo-post": "tsx scripts/verify-open-meteo-post.ts",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:view": "serve -l 9292 ./allure-report",
    "report:allure:serve": "allure serve ./allure-results",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.1",
    "dotenv": "^16.5.0",
    "serve": "^14.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "nodemailer": "^6.10.1"
  }
}
